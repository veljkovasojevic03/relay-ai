# Copy to .env.local and fill in. Every value is optional: missing integrations degrade
# gracefully (Sample mode, simulated n8n, billing off, /api/health reports "degraded").
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- App ---
# Public base URL (no trailing slash). Defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (new project, Free tier). Dashboard: Project Settings -> API Keys ---
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe key: the legacy "anon" key or the newer "publishable" key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS: the legacy "service_role" key or the newer secret key (sb_secret_...).
SUPABASE_SERVICE_ROLE_KEY=

# Salt for hashing visitor IPs before they are stored or rate-limited (>= 16 chars).
IP_HASH_SALT=
# Shared with GitHub Actions; authorizes POST /api/cron/tick (>= 32 chars).
CRON_SECRET=

# --- Cloudflare Turnstile (protects the sandbox sign-in) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- LLM (optional; empty = Sample mode only) ---
ANTHROPIC_API_KEY=
# Defaults below; verify current model names in Anthropic's docs before enabling Live mode.
LLM_MODEL_FREE=claude-haiku-4-5
LLM_MODEL_PRO=claude-sonnet-5-5
# Live replies per day across all bots; after this Live falls back to Sample.
DAILY_REAL_MESSAGE_CAP=200

# --- n8n (local Docker only; never hosted publicly) ---
# simulated | real. Defaults to simulated when N8N_WEBHOOK_BASE is empty (always on Vercel).
N8N_MODE=simulated
# e.g. http://localhost:5678/webhook
N8N_WEBHOOK_BASE=
# HMAC key shared with n8n (>= 32 chars). Required when N8N_MODE=real.
N8N_SHARED_SECRET=

# --- Stripe (TEST MODE ONLY: sk_test_ keys; live keys are rejected at boot) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# --- Google OAuth ---
# Configured in Supabase (Authentication -> Providers -> Google), not read by the app.
# Listed here only so the setup is documented in one place.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
