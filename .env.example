# Copy to .env.local and fill in. Every value except NEXT_PUBLIC_APP_URL is optional:
# missing integrations degrade gracefully (Sample mode, simulated n8n, billing disabled).

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (new project, Free tier) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (optional; without a key the bot runs in Sample mode) ---
ANTHROPIC_API_KEY=
LLM_MODEL_FREE=claude-haiku-4-5
LLM_MODEL_PRO=claude-sonnet-5-5
# Live replies per day across all bots; after this Live falls back to Sample.
DAILY_REAL_MESSAGE_CAP=200

# --- n8n (local Docker; without it events go to the simulated dispatcher) ---
N8N_BASE_URL=http://localhost:5678
# >= 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_SHARED_SECRET=

# --- Stripe (TEST MODE ONLY — sk_test_ keys; live keys are rejected at boot) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cron (GitHub Actions -> /api/cron/tick), >= 32 chars ---
CRON_SECRET=
