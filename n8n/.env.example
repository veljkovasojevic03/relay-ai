# Copy to n8n/.env (git-ignored by the root .env* rule) and fill in.
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Encrypts n8n's saved credentials. Generate once and keep it; changing it locks them.
N8N_ENCRYPTION_KEY=
# The SAME value as N8N_SHARED_SECRET in the app's .env.local.
N8N_SHARED_SECRET=
# Optional: pin an exact n8n version instead of the "stable" tag.
# N8N_VERSION=
