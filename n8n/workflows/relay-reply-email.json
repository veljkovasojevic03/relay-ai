    {
      "parameters": {
        "jsCode": "const req = $('Webhook').first().json.body;\nconst d = req.data || {};\nconst en = d.language === 'en';\n\nconst esc = (s) => String(s ?? '').replace(/[&<>\"']/g, (c) =>\n  ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' })[c]);\nconst oneLine = (s) => String(s ?? '').replace(/[\\r\\n]+/g, ' ').trim().slice(0, 150);\n\nconst shop = d.shopName || req.bot?.name || 'Relay';\n\n// Odgovor vlasnika: prvo escape, pa novi redovi u <br>\nconst reply = esc(d.replyText).replace(/\\r?\\n/g, '<br>');\n\nconst html = `\n  <p>${en ? 'Hi,' : 'Zdravo,'}</p>\n  <p>${en\n    ? `here is the answer from ${esc(shop)} to your question in the chat:`\n    : `evo odgovora iz prodavnice ${esc(shop)} na tvoje pitanje iz četa:`}</p>\n  <blockquote style=\"margin:0;padding:12px 16px;border-left:3px solid #b3472b;background:#faf6f1\">${reply}</blockquote>\n  <p>${en ? 'Best regards,' : 'Pozdrav,'}<br>${esc(shop)}</p>\n`;\n\nreturn [{ json: {\n  to: d.visitorEmail,\n  subject: oneLine(en ? `Reply from ${shop}` : `Odgovor iz prodavnice ${shop}`),\n  html,\n} }];\n"
      },
