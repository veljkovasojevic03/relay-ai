    {
      "parameters": {
        "jsCode": "const req = $('Webhook').first().json.body;\nconst p = (req.data && req.data.params) || {};\n\n// Escape: tekst od kupca ne sme postati HTML (<script>, <b>, & ...)\nconst esc = (s) => String(s ?? '').replace(/[&<>\"']/g, (c) =>\n  ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' })[c]);\n\n// Subject mora biti u jednom redu (novi red u subject-u = header injection)\nconst oneLine = (s) => String(s ?? '').replace(/[\\r\\n]+/g, ' ').trim().slice(0, 150);\n\n// Referenca: RLY- + 4 cifre (za sada nasumično)\nconst ticketRef = 'RLY-' + String(Math.floor(Math.random() * 10000)).padStart(4, '0');\n\nconst inboxUrl = `http://localhost:3000/dashboard/inbox/${req.data?.conversationId ?? ''}`;\n\nconst html = `\n  <h2>Novi tiket ${ticketRef}</h2>\n  <p><b>Prodavnica:</b> ${esc(req.bot?.name)}</p>\n  <p><b>Naslov:</b> ${esc(p.subject)}</p>\n  <p><b>Opis:</b><br>${esc(p.description).replace(/\\n/g, '<br>')}</p>\n  <p><b>Mejl kupca:</b> ${p.visitorEmail ? esc(p.visitorEmail) : 'nije ostavljen'}</p>\n  <p><a href=\"${esc(inboxUrl)}\">Otvori razgovor u inbox-u</a></p>\n`;\n\nreturn [{\n  json: {\n    ticketRef,\n    to: req.owner?.notificationEmail,\n    subject: `[Relay] Novi tiket ${ticketRef}: ${oneLine(p.subject)}`,\n    html,\n  },\n}];\n"
      },
