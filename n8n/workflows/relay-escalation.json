    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst eventId = $('Webhook').first().json.body.eventId;\nconst err = $json.error;              // postoji samo ako Send Email nije uspeo\nconst status = err ? 'failed' : 'sent';\n\n// Isti recept kao u Lekciji 2, ali sada TI potpisuješ\nconst ts = String(Date.now());\nconst signature = crypto.createHmac('sha256', $env.N8N_SHARED_SECRET)\n  .update(`${ts}.${eventId}`).digest('hex');\n\nconst body = { eventId, status };\nif (err) body.error = String(err.message ?? err).slice(0, 300);\n\nreturn [{ json: { ts, signature, body } }];\n"
      },
