    {
      "parameters": {
        "jsCode": "const req = $('Webhook').first().json.body;\nconst d = req.data || {};\nconst en = req.owner?.language === 'en';\n\nconst esc = (s) => String(s ?? '').replace(/[&<>\"']/g, (c) =>\n  ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' })[c]);\nconst oneLine = (s) => String(s ?? '').replace(/[\\r\\n]+/g, ' ').trim().slice(0, 150);\n\nconst reasons = en\n  ? { unknown_twice: \"The bot didn't know the answer twice in a row.\",\n      requested: 'The customer asked to talk to a person.',\n      action_failed: 'An action failed and the customer asked for a person.' }\n  : { unknown_twice: 'Bot dvaput zaredom nije znao odgovor.',\n      requested: 'Kupac je tražio razgovor sa osobom.',\n      action_failed: 'Akcija nije uspela, pa je kupac tražio osobu.' };\nconst roles = en\n  ? { visitor: 'Customer', bot: 'Bot', human: 'You', system: 'System' }\n  : { visitor: 'Kupac', bot: 'Bot', human: 'Ti', system: 'Sistem' };\n\nconst messages = (d.lastMessages || []).map((m) =>\n  `<p><b>${esc(roles[m.role] || m.role)}:</b> ${esc(m.text).replace(/\\n/g, '<br>')}</p>`).join('');\n\n// Link samo ako je stvarno http(s) adresa\nconst link = /^https?:\\/\\//.test(d.inboxUrl || '') ? esc(d.inboxUrl) : '';\nconst button = link\n  ? `<p><a href=\"${link}\" style=\"display:inline-block;padding:10px 16px;background:#b3472b;color:#fff;border-radius:8px;text-decoration:none\">${en ? 'Open the chat' : 'Otvori razgovor'}</a></p>`\n  : '';\n\nconst html = `\n  <h2>${en ? 'A customer is waiting for you' : 'Kupac čeka tvoj odgovor'}</h2>\n  <p>${esc(reasons[d.reason] || d.reason)}</p>\n  <p><b>${en ? 'Customer email' : 'Mejl kupca'}:</b> ${d.visitorEmail ? esc(d.visitorEmail) : (en ? 'not given' : 'nije ostavljen')}</p>\n  <h3>${en ? 'Last messages' : 'Poslednje poruke'}</h3>\n  ${messages}\n  ${button}\n`;\n\nreturn [{ json: {\n  to: req.owner?.notificationEmail,\n  subject: oneLine(`[Relay] ${req.bot?.name}: ${en ? 'a customer is waiting' : 'kupac čeka odgovor'}`),\n  html,\n} }];\n"
      },
